{
  "name": "bidbento",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "reset:production": "node prisma/clean.js",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:cloudflare-config": "node scripts/check-cloudflare-config.mjs",
    "test:cloudflare-prisma": "node scripts/check-cloudflare-prisma.mjs",
    "test:real-stats": "node scripts/check-real-stats.mjs",
    "test:category-nav": "node scripts/check-category-nav.mjs",
    "test:stripe-safety": "node scripts/check-stripe-safety.mjs",
    "test:payment-currency": "node --experimental-strip-types scripts/check-payment-currency.mjs",
    "test:mobile-ux": "node scripts/check-mobile-ux.mjs",
    "test:image-url": "node scripts/check-image-url-only.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "clsx": "^2.1.1",
    "dotenv": "17.2.3",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "next": "^15.1.7",
    "pg": "8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20.17.6",
    "@types/pg": "8.15.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.8",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "prisma": "7.9.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "postcss": "^8.5.3",
    "sharp": "^0.35.0"
  }
}
